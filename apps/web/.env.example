# JanGo environment variables
# Copy this file to `.env.local` for local development and fill in real values.
# Never commit an actual `.env` / `.env.local` file with real secrets.

# Supabase project URL (find in Supabase dashboard: Project Settings > API).
# Safe to expose client-side (NEXT_PUBLIC_ prefix required for browser access).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public API key (Project Settings > API > anon/public).
# Safe to expose client-side — RLS policies are the real access control boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (Project Settings > API > service_role).
# SERVER-ONLY. Grants full access bypassing RLS.
# Do NOT prefix with NEXT_PUBLIC_ and never expose this to the client/browser —
# only read it in server-only code (route handlers, server actions, lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
